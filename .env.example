# SHA-256 hex digest of the password required to unlock the hidden
# toolbar after entering the konami sequence. Only the hash is embedded
# in the client bundle — the plaintext never leaves your machine.
#
# Leave empty to disable the prompt (konami unlocks the toolbar directly).
#
# Generate a hash for your password with:
#   node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
#
# Example (hash of "meow"):
#   VITE_HIDDEN_PASSWORD_SHA256=404cdd7bc109c432f8cc2443b45bcfe95980f5107215c645236e577929ac3e52
VITE_HIDDEN_PASSWORD_SHA256=
